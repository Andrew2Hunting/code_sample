  5.         keep assistance_award_unique_key award_id_fain award_id_uri modification_number federal_action_obligation total_obligated_amount total_outlayed_amount_for_overal action_d
> ate action_date_fiscal_year period_of_performance_start_date period_of_performance_current_en treasury_accounts_funding_this_a program_activities_funding_this_ prime_award_transacti
> on_recipien prime_award_transaction_place_of cfda_number assistance_type_code prime_award_base_transaction_des business_types_code action_type_code record_type_code business_types_d
> escription recipient_name
  6.         
.         drop if federal_action_obligation <= 0
  7.         drop if federal_action_obligation == .
