. *======================================
. *======================================
. **# Blue vs White Collar
. *======================================
. *======================================
. 
. {
. 
. cd "`path'/Raw_Data/Blue_White_Collar/2025_Natnl_Empl_Mat_Pred_By_Indus"
C:\Users\nimen\Documents\USU\My Research\My Code Sample\Raw_Data\Blue_White_Collar\2025_Natnl_Empl_Mat_Pred_By_Indus
. 
. local matfiles: dir "." files "*.csv"
. 
. * Define destrings and tostrings
. local vars_to_destring "employment percentofindustry percentofoccupation"
. local vars_to_string "occupationtitle occupationcode occupationtype"
. local first = 1
. 
. foreach file of local matfiles {
  2.         import delimited "`file'", clear
  3. 
.         cap drop projected2034employment projected2034percentofindustry projected2034percentofoccupation employmentchange20242034 employmentpercentchange20242034 occupationsort disp
> laylevel
  4. 
.  *Destring
.         if `: list sizeof local(vars_to_destring)' > 0 {
  5.                 capture destring `vars_to_destring', replace force
  6.                 if _rc!= 0 {
  7.                         display as error "Warning: Some `vars_to_destring' could not be destringed in `file'"
  8.                 }
  9.         }
 10. 
. *Tostring 
.         foreach var of local vars_to_string {
 11.                 capture tostring `var', replace force
 12.                 if _rc!= 0 {
 13.                         capture recast str250 `var'
 14.                 }
 15.          }
 16. 
.         replace occupationcode = subinstr(occupationcode, `"""', "", .) 
 17.         gen filename = "`file'" 
 18.         gen NAICS_match = regexs(1) if regexm(filename, "_([^.]*)\.")
 19.         replace NAICS_match = subinstr(NAICS_match, "ind_", "", .) 
 20.         replace NAICS_match = subinstr(NAICS_match, "p", "P", .) 
 21. 
.         drop filename
 22.         
.         *Assign capial O for other 
.         gen labor_type = "O"
 23. 
.         * Assign W for white collar
.         replace labor_type = "W" if strpos(occupationcode, "11-") > 0
 24.         replace labor_type = "W" if strpos(occupationcode, "13-") > 0
 25.         replace labor_type = "W" if strpos(occupationcode, "15-") > 0
 26.         replace labor_type = "W" if strpos(occupationcode, "17-") > 0
 27.         replace labor_type = "W" if strpos(occupationcode, "19-") > 0
 28.         replace labor_type = "W" if strpos(occupationcode, "21-") > 0
 29.         replace labor_type = "W" if strpos(occupationcode, "23-") > 0
 30.         replace labor_type = "W" if strpos(occupationcode, "25-") > 0
 31.         replace labor_type = "W" if strpos(occupationcode, "27-") > 0
 32.         replace labor_type = "W" if strpos(occupationcode, "29-") > 0
 33.         replace labor_type = "W" if strpos(occupationcode, "41-") > 0
 34.         replace labor_type = "W" if strpos(occupationcode, "42-") > 0
 35. 
.         * Assign 1 for blue collar
.         replace labor_type = "B" if strpos(occupationcode, "45-") > 1
 36.         replace labor_type = "B" if strpos(occupationcode, "47-") > 1
 37.         replace labor_type = "B" if strpos(occupationcode, "49-") > 1
 38.         replace labor_type = "B" if strpos(occupationcode, "51-") > 1
 39.         replace labor_type = "B" if strpos(occupationcode, "53-") > 1
 40.         
.         
.         drop if occupationtype == "Summary"
 41.         
.         collapse (sum) percentofindustry (first) NAICS_match , by(labor_type)
 42.         
.         
.         gen blue_col_prop = percentofindustry if labor_type == "B"
 43.         gen white_col_prop = percentofindustry if labor_type == "W"
 44.         gen other_col_prop = percentofindustry if labor_type == "O"
 45.         
.         collapse (sum) blue_col_prop white_col_prop other_col_prop, by(NAICS_match)
 46.         
.         
.          
.         if `first' == 1 {
 47.                 save temp_combined.dta, replace
 48.                 local first = 0
 49.          }
 50.         else {
 51.                 append using temp_combined.dta, force
 52.                 save temp_combined.dta, replace
 53.         }
 54. }        
