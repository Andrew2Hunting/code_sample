. display "Stata version: `c(stata_version)'"
Stata version: 18.5

. 
. 
. *======================================
. *======================================
. **# BLS 
. *======================================
. *======================================
. {       
.         
. *======================================
. **# MERGING EACH YEAR
. *======================================
. 
. *initializing variables
. local tot_obs_cnt = 0
. local iter = 0
. 
. {
. foreach foldername in 2018 2019 2020 2021 2022 2023 2024 2025 2026{
  2. cd "`path'/Raw_Data/BLS/4_Digit_NAICS_Codes/`foldername'"
  3. 
. local files : dir "." files "*.csv"
  4. 
. * Create an empty dataset to start
. clear
  5. tempfile master`foldername'
  6. save "`master`foldername''", emptyok
  7. 
. 
. foreach file of local files {
  8.     di "Processing `file'..."
  9.     import delimited "`file'", clear varnames(1) stringcols(_all)
 10.     cap drop lq* oty*
 11.                 
.         *Keep only values aggrergated to county level agregations with a spesified county
.         keep if substr(agglvl_code,1,1) == "7"
 12.         drop if substr(area_fips,3,3)=="999"
 13.         *There are two counties with the word "City" in the county name
.         drop if strpos(area_title, "City") > 0 & area_fips !="51036" & area_fips != "51095"
 14.         
.         *Limit sample to continental United States, and drop connecticut
.         drop if substr(area_fips,1,2)=="02"
 15.         drop if substr(area_fips,1,2)=="09"
 16.         drop if substr(area_fips,1,2)=="15"
 17.         drop if substr(area_fips,1,2)=="72"
 18.         drop if substr(area_fips,1,2)=="78"
 19.         
.         drop own_code agglvl_code size_code disclosure_code size_title agglvl_title
 20.         
.         drop if industry_code == ""
 21.                 
.         *quality check measures
.         isid area_fips qtr own_title
 22.         local tot_obs_cnt = `tot_obs_cnt' + _N
 23.         assert c(k) == 15
 24.         assert !missing(area_fips)
 25.         
.     append using "`master`foldername''"
 26.     save "`master`foldername''", replace
 27.         
.         
.         
.         
.         *Record for which data is missing by county
.         import delimited "`file'", clear varnames(1) stringcols(_all)
 28.     cap drop lq* oty*
 29.                 
.         *Keep only values aggrergated to county, as "County, by Supersector -- by ownership sector"
.         keep if substr(agglvl_code,1,1) == "7"
 30.         drop if substr(area_fips,3,3)=="999"
 31.         drop if strpos(area_title, "City") > 0 & area_fips !="51036" & area_fips != "51095"
 32.         
.         *Limit sample to continental United States, and drop connecticut
.         drop if substr(area_fips,1,2)=="02"
 33.         drop if substr(area_fips,1,2)=="09"
 34.         drop if substr(area_fips,1,2)=="15"
 35.         drop if substr(area_fips,1,2)=="72"
 36.         drop if substr(area_fips,1,2)=="78"
 37.         
.         drop if industry_code == ""
 38.         keep area_fips industry_code 
 39.                 
.         if `iter' == 0 {
 40.                 merge m:1 area_fips using "`path'/Raw_Data/BLS/fipslist.dta"
 41.                 gen missing_count = 0
 42.                 replace missing_count = 1 if _merge == 2
 43.                 keep area_fips name missing_count
 44.                 collapse (sum) missing_count (first) name, by(area_fips)
 45.                 local iter = `iter' + 1
 46.                 save "`path'/Raw_Data/BLS/missing_bls.dta", replace 
 47.         }
 48.         else {
 49.                 merge m:1 area_fips using "`path'/Raw_Data/BLS/fipslist.dta"
 50.                 rename _merge  current_missing
 51.                 keep area_fips current_missing
 52.                 replace current_missing = 0 if current_missing == 3 | current_missing == 1
 53.                 replace current_missing = 1 if current_missing == 2
 54.                 collapse (sum) current_missing, by(area_fips) 
 55.                 merge 1:1 area_fips using "`path'/Raw_Data/BLS/missing_bls.dta"
 56.                 replace missing_count = missing_count + current_missing
 57.                 keep area_fips name missing_count
 58.                 save "`path'/Raw_Data/BLS/missing_bls.dta", replace 
 59.         }
 60.         
. use "`master`foldername''", clear       
 61. }
 62. 
. * Cleans all the data with various renaming
. rename area_fips FIPS
 63. label variable FIPS "unique identifier specifying state and county"
 64. rename industry_code NAICS
 65. label variable NAICS "unique identifier specifying inustry sector"
 66. label variable NAICS "unique identifier specifying industry sector" 
 67. label variable year "year"
 68. label variable qtr "quarter"
 69. rename industry_title industry
 70. label variable industry "industry code and title"
 71. rename area_title county
 72. label variable county "county or region name"
 73. rename own_title own
 74. label variable own "private or government ownership"
 75. 
. rename qtrly_estabs_count firm_count
 76. rename firm_count firms
 77. label variable firms "number of firms"
 78. rename total_qtrly_wages total_wages
 79. label variable total_wages "total quarterly wages"
 80. 
. save "`master`foldername''", replace
 81. 
. *save "`path'/`foldername'/`foldername'_merged.dta", replace
. *save "`path'\`foldername'\`foldername'_merged.dta", replace
. * Repeat these steps for every year of data (2018 - 2025)
. }
